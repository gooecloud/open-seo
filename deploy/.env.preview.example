# Isolated preview using one shared Cloudflare Access app for first login only.
AUTH_MODE=access_session
DATABASE_PROVIDER=d1
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_ALLOWED_EMAILS=you@example.com
ACCESS_SESSION_ADMIN_EMAILS=you@example.com
WORKERS_SUBDOMAIN=your-subdomain.workers.dev
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Run pnpm preview:access and copy its aud output here.
POLICY_AUD=replace-with-preview-access-application-aud
# DATAFORSEO_API_KEY=
