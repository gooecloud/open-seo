# Isolated preview using Cloudflare Access only for the first login.
AUTH_MODE=access_session
DATABASE_PROVIDER=d1
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_ALLOWED_EMAILS=you@example.com
ACCESS_SESSION_ADMIN_EMAILS=you@example.com
WORKERS_SUBDOMAIN=your-subdomain.workers.dev
